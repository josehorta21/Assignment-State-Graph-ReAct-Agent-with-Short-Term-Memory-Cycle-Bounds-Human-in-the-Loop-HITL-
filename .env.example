# Optional: custom SQLite checkpoint path. All actions remain simulated.
AGENT_DB_PATH=./data/checkpoints.db
# Hard cap on agent reasoning/tool-selection cycles per turn.
AGENT_MAX_ITERATIONS=6
# UI bind address for local demo; override when running uvicorn.
AGENT_BIND_HOST=127.0.0.1

# Optional, free on-device Ollama tool-call reasoning. Disabled by default.
AGENT_PLANNER=deterministic
OLLAMA_MODEL=qwen2.5:3b
